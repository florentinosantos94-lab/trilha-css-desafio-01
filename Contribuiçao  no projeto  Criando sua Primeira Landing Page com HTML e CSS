/* Estilo para animação de transição suave nos links do menu de navegação */
nav a {
    color: #fff;
    text-decoration: none;
    margin: 0 10px;
    transition: color 0.3s; /* Adiciona transição de cor ao passar o mouse */
}

nav a:hover {
    color: #ffcc00; /* Muda a cor ao passar o mouse sobre o link */
}

/* Estilo para uma animação sutil no header */
header {
    background-color: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    transition: background-color 0.5s; /* Adiciona transição de cor ao passar o mouse */
}

header:hover {
    background-color: #444; /* Altera a cor do header ao passar o mouse sobre ele */
}
